rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: any signed-in Firebase user ──────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // ── users collection ──────────────────────────────────────────────────────
    // Any signed-in user can read profiles (needed for Alumni Skill, Mentor Match).
    // Only the user themselves (or server-side) can write their own doc.
    match /users/{uid} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── followers / following sub-collections ─────────────────────────────────
    match /followers/{uid}/users/{followerId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }

    match /following/{uid}/users/{followingId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── jobs collection ───────────────────────────────────────────────────────
    // Any signed-in user can read. Any signed-in user can CREATE a job
    // (role enforcement happens in the app layer; Firestore rule removed the
    // cross-document get() that was silently failing on cold paths).
    match /jobs/{jobId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.ownerId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    // ── referrals collection ──────────────────────────────────────────────────
    // Any signed-in user can read.
    // Any signed-in user can create, as long as they set their own uid as poster.
    match /referrals/{referralId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.postedByUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.postedByUid == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.postedByUid == request.auth.uid;
    }

    // ── events collection ─────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.ownerId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    // ── saved_jobs / saved_events ─────────────────────────────────────────────
    match /saved_jobs/{docId} {
      allow read:   if isSignedIn();
      allow write:  if isSignedIn();
    }

    match /saved_events/{docId} {
      allow read:   if isSignedIn();
      allow write:  if isSignedIn();
    }

    // ── outcome_tracking collection ───────────────────────────────────────────
    // KEY FIX: any signed-in user can read ALL outcome_tracking docs.
    //   • Students write their own document (uid == their auth uid)
    //   • Alumni need to READ other students' docs for Employment Verification
    //   • Alumni need to UPDATE other students' docs to mark checkIns verified
    //   • Staff need full read/write access for admin oversight
    //
    // We cannot use cross-document get() here (would cause circular permission
    // checks). Role enforcement is handled at the app layer (Flutter UI).
    match /outcome_tracking/{uid} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn();   // alumni verify → update other students' docs
      allow delete: if false;
    }

    // ── chats / messages ──────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();

      match /messages/{messageId} {
        allow read:   if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // ── alumni_verification (seeded demo/KYC data) ────────────────────────────
    match /alumni_verification/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── mentor_requests ───────────────────────────────────────────────────────
    match /mentor_requests/{reqId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && (resource.data.studentUid == request.auth.uid
                       || resource.data.mentorUid == request.auth.uid);
      allow delete: if false;
    }

    // ── meetings collection ───────────────────────────────────────────────────
    // Created by MeetingService.scheduleMeeting().
    // Simplified create rule: any signed-in user can schedule a meeting.
    // (Removed participants array check — brittle if field name changes.)
    match /meetings/{meetingId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.createdBy;
      allow delete: if false;
    }

    // ── job_applications collection ───────────────────────────────────────────
    // Students create applications; alumni (job poster) can read + update status.
    // studentUid must match the creating user. Alumni read by jobId match.
    match /job_applications/{appId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.studentUid == request.auth.uid;
      allow update: if isSignedIn();   // alumni shortlist/reject applicants
      allow delete: if false;
    }

    // ── Default: deny everything not explicitly matched ───────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
